    {
      "parameters": {
        "jsCode": "// Parámetros definidos en el Config\nconst cfg = $('Config – Parámetros RAG').first().json;\n\n// Todos los fragmentos que trajo Pinecone, con su score\nconst todos = $input.all().map(item => ({\n  texto: item.json.document.pageContent,\n  fuente: item.json.document.metadata.fuente,\n  version: item.json.document.metadata.version,\n  score: Number(item.json.score.toFixed(3)),\n}));\n\n// Solo los que superan el Minimum Score\nconst validos = todos.filter(f => f.score >= cfg.min_score);\n\nconst evidencia = validos.length\n  ? validos.map((f, i) =>\n      `[Fragmento ${i + 1} | Fuente: ${f.fuente} v${f.version} | Score: ${f.score}]\\n${f.texto}`\n    ).join('\\n\\n')\n  : 'SIN EVIDENCIA: ningún fragmento del manual supera el umbral mínimo de relevancia.';\n\nreturn [{\n  json: {\n    consulta: cfg.consulta,\n    top_k: cfg.top_k,\n    min_score: cfg.min_score,\n    fragmentos_validos: validos.length,\n    scores_recuperados: todos.map(f => f.score),\n    evidencia,\n  },\n}];"
      },
